@model IEnumerable<T1_ManuelSejuro.Models.Prestamos>

@{
    ViewData["Title"] = "Préstamos por Año";
}

<h1>Préstamos por Año</h1>

<form asp-action="Index" asp-controller="Prestamos">
    <em>Ingrese Año</em>
    @Html.TextBox("year", DateTime.Now.Year, new { type = "number" })
    <button class="btn btn-primary">Buscar</button>
</form>

<p>Se encontraron @ViewBag.totalRegistros registros</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.idPrestamo)</th>
            <th>@Html.DisplayNameFor(model => model.nombre_cliente)</th>
            <th>@Html.DisplayNameFor(model => model.nombre_libro)</th>
            <th>@Html.DisplayNameFor(model => model.fechaPrestamo)</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.idPrestamo)</td>
                <td>@Html.DisplayFor(modelItem => item.nombre_cliente)</td>
                <td>@Html.DisplayFor(modelItem => item.nombre_libro)</td>
                <td>@Html.DisplayFor(modelItem => item.fechaPrestamo)</td>
            </tr>
        }
    </tbody>
</table>

@if (ViewBag.totalRegistros > 0)
{
    <div>
        @for (int i = 0; i < ViewBag.totalPaginas; i++)
        {
            <a asp-action="Index"
            asp-route-page="@(i + 1)"
            asp-route-year="@ViewBag.year"
               class="@(i == ((int)ViewBag.page - 1) ? "btn btn-success" : "btn btn-primary")">
                @(i + 1)
            </a>
        }
    </div>
}