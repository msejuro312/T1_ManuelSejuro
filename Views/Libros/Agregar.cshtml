@model IEnumerable<T1_ManuelSejuro.Models.Libros>

@{
    ViewData["Title"] = "Agregar";
}

<h1>Agregar Libro</h1>

@if (TempData["mensaje"] != null)
{
    <div class="alert alert-success">@TempData["mensaje"]</div>
}

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Agregar" method="post">
            <div class="form-group">
                <label class="control-label">Título</label>
                <input name="titulo" class="form-control" required />
            </div>
            <div class="form-group">
                <label class="control-label">Autor</label>
                @Html.DropDownList("idAutor", (SelectList)ViewBag.Autores, "Seleccione...", new { @class = "form-control" })
            </div>
            <div class="form-group">
                <label class="control-label">Año de Publicación</label>
                <input name="anio_publicacion" type="number" class="form-control" value="@DateTime.Now.Year" required />
            </div>
            <div class="form-group" style="margin-top:10px">
                <input type="submit" value="Agregar" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<hr />

<h4>Lista de Libros</h4>
@await Html.PartialAsync("_ListaLibros", Model)
